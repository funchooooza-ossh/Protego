{
    "go.formatTool": "gofumpt",
    "[go]": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "always",
            "source.fixAll": "always"
        }
    },
    "go.languageServerExperimentalFeatures": {
        "diagnostics": true
    }
}
